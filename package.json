{
  "name": "numberparrot",
  "version": "0.1.1",
  "description": "Parse localized number and currency strings in JavaScript. The missing Intl.NumberFormat parser: convert \"1.234,56\", \"1 234,56 €\", \"12,34,567.89\" or Arabic digits back into real numbers for any locale. Zero dependencies, TypeScript, numeral.js alternative.",
  "keywords": [
    "parse",
    "number",
    "parse-number",
    "parse localized number",
    "parse localized number javascript",
    "convert string with comma to number javascript",
    "parse currency string to number javascript",
    "parseFloat comma decimal",
    "parsefloat",
    "intl number parse",
    "intl",
    "Intl.NumberFormat",
    "number parser",
    "currency parser",
    "currency",
    "money",
    "decimal separator",
    "thousands separator",
    "comma",
    "locale",
    "i18n",
    "l10n",
    "internationalization",
    "localization",
    "numeral.js alternative",
    "numeral",
    "arabic digits",
    "indian numbering",
    "accounting",
    "typescript"
  ],
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "license": "MIT",
  "homepage": "https://kwy404.github.io/numberparrot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/numberparrot.git"
  },
  "bugs": {
    "url": "https://github.com/kwy404/numberparrot/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-docs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-chars.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "docs": "node scripts/build-assets.mjs && node scripts/build-docs.mjs && npm run docs:highlight",
    "docs:highlight": "node scripts/highlight-docs.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "shiki": "^3.23.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
