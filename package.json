{
  "name": "numberparrot",
  "version": "1.1.0",
  "description": "Parse numbers and currency strings written in any locale back into JavaScript numbers.",
  "keywords": [
    "number",
    "parse",
    "locale",
    "intl",
    "currency",
    "i18n",
    "decimal-separator",
    "typescript"
  ],
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "license": "MIT",
  "homepage": "https://kwy404.github.io/numberparrot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/numberparrot.git"
  },
  "bugs": {
    "url": "https://github.com/kwy404/numberparrot/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-docs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-chars.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "docs": "node scripts/build-assets.mjs && node scripts/seasons-art.mjs && node scripts/build-docs.mjs && npm run docs:highlight",
    "docs:highlight": "node scripts/highlight-docs.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "shiki": "^3.23.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
